; Provides conversions between different encodings
#once
#include stdlib/generalMacros.mbim
#include stdlib/recursion.mbim
#include stdlib/lists.mbim
#include stdlib/scottArithmetics.mbim
#include stdlib/churchArithmetics.mbim

let
  ; Converts a church numeral to a scott numeral
  ; Parameter n: The church encoded numeral to convert
  ; Returns: A scott encoded numeral
  churchToScott := \n -> n Ss 0,

  ; Converts a scott numeral to a church numeral
  ; Parameter n: The scott encoded numeral to convert
  ; Returns: A church encoded numeral
  scottToChurch :=
    let scottToChurch' := \scottToChurch.\n ->
      \f.\x.n x (\p -> f (((scottToChurch p)) f x))
    in
      rec scottToChurch',

  ; General implementation to convert a string of any
  ; encoding to a string.
  ; Parameter div:
  ;  Integer division function for the used
  ;  integer encoding
  ; Parameter mod:
  ;  Modulo function for the used integer
  ;  encoding
  ; Parameter add:
  ;  Add function for the used integer encoding
  ; Parameter ten:
  ;  The number 10 encoded in the used
  ;  integer encoding
  ; Parameter ascii0:
  ;  The number 48 encoded in the used
  ;  integer encoding
  ; Parameter n:
  ;  The number to convert
  ; Returns:
  ;  A string in the form of a scott encoded list
  ;  of encoded numerals
  intToString :=
    let intToString' :=
      rec (\intToString'.\div.\mod.\add.\ten.\ascii0.\n ->
        n nil ; zero case
          (\_ -> append ; S _ case
            (intToString' div mod add ten ascii0 (div n ten))
            [ add ascii0 (mod n ten) ])
      )
    in
      \div.\mod.\add.\ten.\ascii0.\n ->
        n [ ascii0 ] (\_ -> intToString' div mod add ten ascii0 n),

  ; Converts a scott integer to its string representation
  ; Parameter n: The integer to convert
  ; Returns: A string in the form of a scott encoded list
  ;          of scott encoded numerals
  toString<ints> := intToString divs mods adds 10s 48s,

  ; General implementation to convert a list to a string
  ; using a given function that converts an element of that
  ; list to a string
  ; Parameter elToString:
  ;  toString function for the element type
  ; Parameter l:
  ;  The list of elements to convert to string representation
  ; Returns:
  ;  A string representing the list
  listToString :=
    ; Helper function that returns the list as alternating commas and numbers (with a leading comma)
    let listToString' :=
      rec (\listToString'.\elToString.\l ->
        l []
          (\x.\xs ->
            cons ','
              (append
                (elToString x)
                (listToString' elToString xs)
              )
          )
      )
    in
      \elToString.\l ->
        l (
            "[]" ; Empty list
          )
          (\x.\xs ->
            cons
              '[' ; wrap the result of intListToString' in []
              (skip 1 (append ; Skip the first comma
                (listToString' elToString l)
                "]")
              )
          ),

  intListToString :=
    ; Helper function that returns the list as alternating commas and numbers (with a leading comma)
    let intListToString' :=
      rec (\intListToString'.\div.\mod.\add.\ten.\ascii0.\l ->
        l []
          (\x.\xs ->
            cons ','
              (append
                (intToString div mod add ten ascii0 x)
                (intListToString' div mod add ten ascii0 xs)
              )
          )
      )
    in
      \div.\mod.\add.\ten.\ascii0.\l -> 
        l (
            "[]" ; Empty list
          )
          (\x.\xs ->
            cons
              '[' ; wrap the result of intListToString' in []
              (skip 1 (append ; Skip the first comma
                (intListToString' div mod add ten ascii0 l) 
                "]")
              )
          ),

  toString<List<ints>> := listToString toString<ints>,

  toString<bool> := \b -> if b then "true" else "false" end,
  toString<List<bool>> := listToString toString<bool>,

  toStrictList := rec (\toStrictList -> \lazyList ->
                        lazyList nil (\x.\xs -> cons x (toStrictList (force xs)))
                      ),
  toLazyList := rec (\toLazyList -> \strictList ->
                        strictList nil (\x.\xs -> cons x (lazy (toLazyList xs)))
                      ),
in

