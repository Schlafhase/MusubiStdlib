; Utilities for scott encoded lists
; Scott encoded lists can be used for pattern matching like this:
; l {nil case} {x:xs case}

#once
#include stdlib/generalMacros.mbim
#include stdlib/recursion.mbim
#include stdlib/boolean.mbim
#include stdlib/listsBasic.mbim

let
  ; Takes a specified amount of elements from the start of a list
  ; Parameter n:
  ;  The number of elements to take
  ; Parameter l:
  ;  The list to take the elements from
  ; Returns:
  ;  A list containing the first `n` items of `l`
  take := 
    rec (\take' -> \n -> \l ->
      if isZero n then
        nil
      else
        l nil (\x.\xs -> cons x (take' (pred n) xs))
      end
    ),

  ; Skips a specified amount of elements in a list
  ; Parameter n:
  ;  The number of elements to skip
  ; Parameter l:
  ;  The list which holds the elements
  ; Returns:
  ;  A list containing all elements after the first `n` elements of `l`
  skip := 
    rec (\skip -> \n -> \l ->
      n l (\p -> l nil (\x.\xs -> skip p xs))
    ),

  ; Returns an element at a given index of a list
  ; Parameter n:
  ;  The index of the element
  ; Parameter l:
  ;  The list which contains the element
  ; Returns:
  ;  The element at index `n` of `l`
  getAt := 
    rec (\getAt -> \n -> \l ->
      l 0
        (\x.\xs -> n x (\p -> getAt p xs))
    ),

  repeat :=
    rec (\repeat -> \el -> \n ->
      if isZero n then
        nil
      else
        el : (repeat el (pred n))
      end
    ),

  ; Returns the length of a list
  ; Parameter l:
  ;  List to find the length of
  ; Returns:
  ;  The length of `l`
  length := 
    rec (\length.\l.
      l 0 ; nil case
        (\x.\xs -> S (length xs))
    ),

  ; Appends one list to another list
  ; Parameter l1:
  ;  First list
  ; Parameter l2:
  ;  Second list
  ; Returns:
  ;  A list with all elements in `l1` followed by all elements of `l2`
  append := 
    rec (\append -> \l1 -> \l2 ->
      l1 l2 ; nil case
        (\x.\xs -> cons x (append xs l2))
    ),

  ; Appends one list to another list
  ; Parameter l1:
  ;  First list
  ; Parameter l2:
  ;  Second list
  ; Returns:
  ;  A list with all elements in `l1` followed by all elements of `l2`
  infixl 99999 @ := append,

  ; Reverses a list
  ; Parameter l:
  ;  The list to reverse
  ; Returns:
  ;  The reversed list
  reverse :=
    rec (\reverse -> \l ->
      l nil ; nil case
        (\x.\xs -> append (reverse xs) [ x ])
    ),

  ; Applies a function to every element in a list
  ; Parameter f:
  ;  The function to apply
  ; Parameter l:
  ;  The list to operate on
  ; Returns:
  ;  A list of the results for `f x` for each element in `l`
  map :=
    let
      map' := \map -> \f -> \l ->
        l nil ; nil case
          (\x.\xs -> cons (f x) (map f xs))
    in
      rec map',
in
