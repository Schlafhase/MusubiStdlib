; Utilities for scott encoded lists
; Scott encoded lists can be used for pattern matching like this:
; l {nil case} {x:xs case}

#once
#include stdlib/generalMacros.mbim
#include stdlib/recursion.mbim
#include stdlib/boolean.mbim
#include stdlib/listsBasic.mbim

let
  ; Takes a specified amount of elements from the start of a list
  ; Parameter n:
  ;  The number of elements to take
  ; Parameter l:
  ;  The list to take the elements from
  ; Returns:
  ;  A list containing the first `n` items of `l`
  take := 
    rec (\take -> \n -> \l ->
      ; NOTE: can't use the scott-encoding style pattern matching here
      ; because lists should work with any integer encoding
      if isZero n then
        nil
      else
        l nil (\x.\xs -> cons x (take (pred n) xs))
      end
    ),

  ; Skips a specified amount of elements in a list
  ; Parameter n:
  ;  The number of elements to skip
  ; Parameter l:
  ;  The list which holds the elements
  ; Returns:
  ;  A list containing all elements after the first `n` elements of `l`
  skip := 
    rec (\skip -> \n -> \l ->
      n l (\p -> l nil (\x.\xs -> skip p xs))
    ),

  ; Returns an element at a given index of a list
  ; Parameter n:
  ;  The index of the element
  ; Parameter l:
  ;  The list which contains the element
  ; Returns:
  ;  The element at index `n` of `l`
  getAt := 
    rec (\getAt -> \n -> \l ->
      l 0
        (\x.\xs -> 
          if isZero n then
            x
          else
            getAt (pred n) xs
          end
        )
    ),

  ; Returns the length of a list
  ; Parameter l:
  ;  List to find the length of
  ; Returns:
  ;  The length of `l`
  length := 
    rec (\length.\l.
      l 0 ; nil case
        (\x.\xs -> S (length xs))
    ),
in
