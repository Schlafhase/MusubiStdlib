; Booleans
#once

let
  ; The if, then, else and end macros provide a way to use
  ; readable branching which also gives you lazy evaluation
  ; for free. Only the branch that gets returned will be
  ; evaluated.
  #define if (((
  #define then )(\_.
  #define else )(\_.
  #define end )) (\x.x))
  ; true :: a' -> b' -> a'
  true := \a.\b.a,
  ; false :: a' -> b' -> b'
  false := 0c, ; 0c is equivalent to \a.\b.b
  ; typedef bool = true | false

  ; not :: bool -> bool
  not := \x.x false true,
  ; and :: bool -> bool -> bool
  infixl 20 and := \a.\b.a b false,
  ; or :: bool -> bool -> bool
  infixl 20 or := \a.\b.a true b,
  ; xor :: bool -> bool -> bool
  infixl 20 xor := \a.\b.a (not b) b
in
