; Booleans
#once

let
  ; The if, then, else and end macros provide a way to use
  ; readable branching which also gives you lazy evaluation
  ; for free. Only the branch that gets returned will be
  ; evaluated.
  #define if (((
  #define then )(\_THEN_DISCARD.
  #define else )(\_ELSE_DISCARD.
  #define end )) (\x.x))
  ; `true`
  true := \a.\b.a,
  ; `false`
  false := 0c, ; 0c is equivalent to \a.\b.b
  ; `not`
  not := \x.x false true,
  infixl 20 and := \a.\b.if not a then false else b end,
  infixl 20 nand := \a.\b.if not a then true else not b end,
  infixl 20 or := \a.\b.if a then true else b end,
  infixl 20 nor := \a.\b.if a then false else not b end,
  infixl 20 xor := \a.\b.if a then (not b) else b end,
  infixl 20 xnor := \a.\b.if a then b else (not b) end,
in
