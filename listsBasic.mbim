; All definitions for lists that need close to no dependencies.
; Use stdlib/lists.mbim (which also includes this module) for more
; utilities related to lists.

#once
#define [ (cons (
#define ] ) nil)
#include stdlib/recursion.mbim
#include stdlib/generalMacros.mbim
#include stdlib/boolean.mbim

let
  ; Nil is the empty list
  nil := \n.\c.n,
  ; Nil is the empty list
  [] := nil,
  ; Checks if a list is nil
  isNil := \l -> l true (\_.\_.false),
  ; Cons adds an element to the start of a list
  ; Parameter x:
  ;  The element to add
  ; Parameter xs:
  ;  The list to add the element to
  ; Returns:
  ;  The resulting list
  cons := \x.\xs.\n.\c.c x xs,
  ; Cons adds an element to the start of a list
  ; Parameter x:
  ;  The element to add
  ; Parameter xs:
  ;  The list to add the element to
  ; Returns:
  ;  The resulting list
  infixr 50 : := cons,

  listEq :=
    rec(\listEq.
      \a -> \b -> \eq ->
        a (isNil b)
          (\ax.\axs ->
            b false
              (\bx.\bxs ->
                if not (eq ax bx) then
                  false
                else
                  listEq axs bxs eq
                end
              )
          )
    ),
  ; Returns the head of a list
  ; Parameter l:
  ;  The list to get the head of
  ; Returns:
  ;  The head or nil if the list is nil
  head := \l.l nil (\x.\xs.x),
  ; Returns the tail of a list
  ; Parameter l:
  ;  The list to get the tail of
  ; Returns:
  ;  The tail
  tail := \l.l nil (\x.\xs.xs),

  ; Appends one list to another list
  ; Parameter l1:
  ;  First list
  ; Parameter l2:
  ;  Second list
  ; Returns:
  ;  A list with all elements in `l1` followed by all elements of `l2`
  append := 
    rec (\append -> \l1 -> \l2 ->
      l1 l2 ; nil case
        (\x.\xs -> cons x (append xs l2))
    ),

  ; Appends one list to another list
  ; Parameter l1:
  ;  First list
  ; Parameter l2:
  ;  Second list
  ; Returns:
  ;  A list with all elements in `l1` followed by all elements of `l2`
  infixl 99999 @ := append,

  ; Reverses a list
  ; Parameter l:
  ;  The list to reverse
  ; Returns:
  ;  The reversed list
  reverse :=
    rec (\reverse -> \l ->
      l nil ; nil case
        (\x.\xs -> append (reverse xs) [ x ])
    ),

  ; Applies a function to every element in a list
  ; Parameter f:
  ;  The function to apply
  ; Parameter l:
  ;  The list to operate on
  ; Returns:
  ;  A list of the results for `f x` for each element in `l`
  map :=
    let
      map' := \map -> \f -> \l ->
        l nil ; nil case
          (\x.\xs -> cons (f x) (map f xs))
    in
      rec map',

  flatten :=
    rec (\flatten.\l ->
      l nil
        (\x.\xs -> x @ flatten xs)
    ),

  stringJoin :=
    rec (\stringJoin.\sep -> \l ->
      l nil
        (\x.\xs -> x @ sep @ (stringJoin sep xs))
    ),

  ; Checks if a list of booleans only contains `true`
  ; Parameter l:
  ;  `List<bool>` to check
  ; Returns:
  ;  `true` when `l` is empty or only contains `true`
  ;  `false` otherwise
  all :=
    rec (\all.
      \l ->
        l true (\x.\xs ->
          if not x then
            false
          else
            all xs
          end
        )
    ),

  ; Checks if a list of booleans contains `true`
  ; Parameter l:
  ;  `List<bool>` to check
  ; Returns:
  ;  `true` when `l` is not empty and contains `true`
  ;  `false` otherwise
  any :=
    rec (\any.
      \l ->
        l false (\x.\xs ->
          if x then
            true
          else
            any xs
          end
        )
    ),

  ; `applyAll` cannot have a signature because it accepts functions with arbitrarily
  ; many parameters of any type.
  ; It takes a function and a list and applies all elements in that list to the function
  ; starting with the first element in the list.
  applyAll :=
    rec (\applyAll.
      \f -> \l ->
        l f (\x.\xs -> applyAll (f x) xs)
    ),

  ; Skips a specified amount of elements in a list
  ; Parameter n:
  ;  The number of elements to skip
  ; Parameter l:
  ;  The list which holds the elements
  ; Returns:
  ;  A list containing all elements after the first `n` elements of `l`
  skip := 
    ; TODO: only works with scott numbers
    rec (\skip -> \n -> \l ->
      n l (\p -> l nil (\x.\xs -> skip p xs))
    ),

  skipWhile :=
    rec (\skipWhile -> \pred -> \l ->
      l nil (\x.\xs -> 
        if pred x then
          skipWhile pred xs
        else
          l
        end
      )
    ),

  ; TODO: test this
  ; `aggregate TElement TResult :: TElement[] -> (TElement -> TResult -> TResult) -> TResult -> TResult`
  aggregate :=
    rec (\aggregate -> \source -> \f -> \acc ->
      source
        acc ; nil
        (\x.\xs -> aggregate xs f (f x acc))
    ),
in
