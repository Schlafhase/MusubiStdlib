; The pipe operator '|' allows piping arguments to 
; functions.
; Example: '(5 + 6) | toString<int>'
#once

let
  ; Pipe operator
  ; Parameter x:
  ;  The value to pipe to the function
  ; Parameter f:
  ;  The function to pipe the value to
  ; Returns:
  ;  Whatever `f` returns
  infixl 0 | := \x.\f.f x,
in
